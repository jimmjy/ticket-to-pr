# 1 = fake model responses (free, no keys needed). Set to 0 for real runs.
MOCK=1

# Needed when MOCK=0 (spec writer, reviewer, judge)
ANTHROPIC_API_KEY=

# Langfuse (optional until Part 7). Use the URL for the region you signed up in.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Models
LLM_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5
CLAUDE_CODE_MODEL=sonnet
MAX_ATTEMPTS=3
